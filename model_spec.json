      "owner = {req1 ↦ a1, req2 ↦ a2, req3 ↦ a3}"
    ],
    [
      "pilot10",
      "need = {req1 ↦ readCap, req2 ↦ writeCap, req3 ↦ readCap}"
    ],
    [
      "pilot11",
      "budget = 2"

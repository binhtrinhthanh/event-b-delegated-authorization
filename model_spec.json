    [
      "axm11",
      "path ∈ NODE → ℙ(NODE)"
    ],
    [
      "axm12",
      "path(root) = {root}"
    ],
    [
      "axm13",
      "∀a · a ∈ NODE ∖ {root} ⇒ path(a) = {a} ∪ path(parent(a))"
    ],
    [
      "axm14",
      "owner ∈ JOB → (NODE ∖ {root})"
    ],
    [
      "axm15",
      "need ∈ JOB → CAP"
    ],
    [
      "axm16",
      "budget ∈ ℕ1"

    [
      "axm08",
      "rank ∈ NODE → ℕ"
    ],
    [
      "axm09",
      "rank(root) = 0"
    ],
    [
      "axm10",
      "∀a · a ∈ NODE ∖ {root} ⇒ rank(parent(a)) < rank(a)"

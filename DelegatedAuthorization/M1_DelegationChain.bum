    <org.eventb.core.guard name="g0" org.eventb.core.label="grd1" org.eventb.core.predicate="a ∈ issued ∖ revoked" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g1" org.eventb.core.label="grd2" org.eventb.core.predicate="P = scope ∩ {x,k · x ∈ NODE ∧ k ∈ CAP ∧ path(x) ∩ (revoked ∪ {a}) = ∅ ∣ x ↦ k}" org.eventb.core.theorem="false" />
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="auth ≔ P" />

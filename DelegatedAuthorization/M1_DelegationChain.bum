  <org.eventb.core.invariant name="inv13b" org.eventb.core.label="inv13b" org.eventb.core.predicate="∀a · a ∈ NODE ∖ issued ⇒ scope[{a}] = ∅" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv14" org.eventb.core.label="inv14" org.eventb.core.predicate="scope[{root}] = rootScope" org.eventb.core.theorem="false" />

    <org.eventb.core.guard name="g1" org.eventb.core.label="grd2" org.eventb.core.predicate="owner(j) ↦ need(j) ∈ auth" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g2" org.eventb.core.label="grd3" org.eventb.core.predicate="used &lt; budget" org.eventb.core.theorem="false" />

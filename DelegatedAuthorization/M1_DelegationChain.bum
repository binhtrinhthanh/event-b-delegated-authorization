    <org.eventb.core.guard name="g7" org.eventb.core.label="grd8" org.eventb.core.predicate="P = (scope ∪ ({a} × S)) ∩ {x,k · x ∈ NODE ∧ k ∈ CAP ∧ path(x) ∩ revoked = ∅ ∣ x ↦ k}" org.eventb.core.theorem="false" />
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="auth ≔ P" />
    <org.eventb.core.action name="a1" org.eventb.core.label="act2" org.eventb.core.assignment="issued ≔ issued ∪ {a}" />
    <org.eventb.core.action name="a2" org.eventb.core.label="act3" org.eventb.core.assignment="scope ≔ scope ∪ ({a} × S)" />
  </org.eventb.core.event>

  <org.eventb.core.invariant name="inv16" org.eventb.core.label="inv16" org.eventb.core.predicate="∀a · a ∈ issued ⇒ path(a) ⊆ issued" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv16b" org.eventb.core.label="inv16b" org.eventb.core.predicate="∀a · a ∈ issued ∖ {root} ⇒ parent(a) ∈ issued" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv17" org.eventb.core.label="inv17" org.eventb.core.predicate="∀a · a ∈ issued ∖ {root} ⇒ scope[{a}] ⊆ scope[{parent(a)}]" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv18" org.eventb.core.label="inv18" org.eventb.core.predicate="∀a · a ∈ issued ⇒ scope[{a}] ≠ ∅" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv18b" org.eventb.core.label="inv18b" org.eventb.core.predicate="∀a · a ∈ issued ⇒ scope[{a}] ⊆ rootScope" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv19" org.eventb.core.label="inv19" org.eventb.core.predicate="auth = scope ∩ {x,k · x ∈ NODE ∧ k ∈ CAP ∧ path(x) ∩ revoked = ∅ ∣ x ↦ k}" org.eventb.core.theorem="false" />

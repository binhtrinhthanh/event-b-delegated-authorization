    <org.eventb.core.parameter name="p1" org.eventb.core.identifier="S" />
    <org.eventb.core.parameter name="p2" org.eventb.core.identifier="P" />
    <org.eventb.core.guard name="g0" org.eventb.core.label="grd1" org.eventb.core.predicate="a ∈ NODE ∖ issued" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g1" org.eventb.core.label="grd2" org.eventb.core.predicate="a ∈ NODE ∖ {root}" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g2" org.eventb.core.label="grd3" org.eventb.core.predicate="parent(a) ∈ issued" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g3" org.eventb.core.label="grd4" org.eventb.core.predicate="path(parent(a)) ∩ revoked = ∅" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g4" org.eventb.core.label="grd5" org.eventb.core.predicate="S ⊆ scope[{parent(a)}]" org.eventb.core.theorem="false" />

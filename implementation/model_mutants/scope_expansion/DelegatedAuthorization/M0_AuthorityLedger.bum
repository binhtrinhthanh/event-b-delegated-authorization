<?xml version='1.0' encoding='UTF-8'?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
  <org.eventb.core.seesContext name="see" org.eventb.core.target="C_Delegation" />
  <org.eventb.core.variable name="v0" org.eventb.core.identifier="auth" />
  <org.eventb.core.variable name="v1" org.eventb.core.identifier="pending" />
  <org.eventb.core.variable name="v2" org.eventb.core.identifier="committed" />
  <org.eventb.core.variable name="v3" org.eventb.core.identifier="cancelled" />
  <org.eventb.core.variable name="v4" org.eventb.core.identifier="used" />
  <org.eventb.core.invariant name="inv01" org.eventb.core.label="inv01" org.eventb.core.predicate="auth ⊆ NODE × CAP" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv02" org.eventb.core.label="inv02" org.eventb.core.predicate="pending ⊆ JOB" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv02f" org.eventb.core.label="inv02f" org.eventb.core.predicate="finite(pending)" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv03" org.eventb.core.label="inv03" org.eventb.core.predicate="committed ⊆ JOB" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv03f" org.eventb.core.label="inv03f" org.eventb.core.predicate="finite(committed)" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv04" org.eventb.core.label="inv04" org.eventb.core.predicate="cancelled ⊆ JOB" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv05" org.eventb.core.label="inv05" org.eventb.core.predicate="pending ∩ committed = ∅" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv06" org.eventb.core.label="inv06" org.eventb.core.predicate="pending ∩ cancelled = ∅" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv07" org.eventb.core.label="inv07" org.eventb.core.predicate="committed ∩ cancelled = ∅" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv08" org.eventb.core.label="inv08" org.eventb.core.predicate="used ∈ ℕ" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv09" org.eventb.core.label="inv09" org.eventb.core.predicate="used = card(pending) + card(committed)" org.eventb.core.theorem="false" />
  <org.eventb.core.invariant name="inv10" org.eventb.core.label="inv10" org.eventb.core.predicate="used ≤ budget" org.eventb.core.theorem="false" />
  <org.eventb.core.event name="e0" org.eventb.core.label="INITIALISATION" org.eventb.core.convergence="0" org.eventb.core.extended="false">
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="auth ≔ {root} × rootScope" />
    <org.eventb.core.action name="a1" org.eventb.core.label="act2" org.eventb.core.assignment="pending ≔ ∅" />
    <org.eventb.core.action name="a2" org.eventb.core.label="act3" org.eventb.core.assignment="committed ≔ ∅" />
    <org.eventb.core.action name="a3" org.eventb.core.label="act4" org.eventb.core.assignment="cancelled ≔ ∅" />
    <org.eventb.core.action name="a4" org.eventb.core.label="act5" org.eventb.core.assignment="used ≔ 0" />
  </org.eventb.core.event>
  <org.eventb.core.event name="e1" org.eventb.core.label="SetAuthority" org.eventb.core.convergence="0" org.eventb.core.extended="false">
    <org.eventb.core.parameter name="p0" org.eventb.core.identifier="P" />
    <org.eventb.core.guard name="g0" org.eventb.core.label="grd1" org.eventb.core.predicate="P ⊆ NODE × CAP" org.eventb.core.theorem="false" />
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="auth ≔ P" />
  </org.eventb.core.event>
  <org.eventb.core.event name="e2" org.eventb.core.label="Reserve" org.eventb.core.convergence="0" org.eventb.core.extended="false">
    <org.eventb.core.parameter name="p0" org.eventb.core.identifier="j" />
    <org.eventb.core.guard name="g0" org.eventb.core.label="grd1" org.eventb.core.predicate="j ∈ JOB ∖ (pending ∪ committed ∪ cancelled)" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g1" org.eventb.core.label="grd2" org.eventb.core.predicate="owner(j) ↦ need(j) ∈ auth" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g2" org.eventb.core.label="grd3" org.eventb.core.predicate="used &lt; budget" org.eventb.core.theorem="false" />
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="pending ≔ pending ∪ {j}" />
    <org.eventb.core.action name="a1" org.eventb.core.label="act2" org.eventb.core.assignment="used ≔ used + 1" />
  </org.eventb.core.event>
  <org.eventb.core.event name="e3" org.eventb.core.label="Commit" org.eventb.core.convergence="0" org.eventb.core.extended="false">
    <org.eventb.core.parameter name="p0" org.eventb.core.identifier="j" />
    <org.eventb.core.parameter name="p1" org.eventb.core.identifier="R" />
    <org.eventb.core.guard name="g0" org.eventb.core.label="grd1" org.eventb.core.predicate="j ∈ pending" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g1" org.eventb.core.label="grd2" org.eventb.core.predicate="owner(j) ↦ need(j) ∈ auth" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g2" org.eventb.core.label="grd3" org.eventb.core.predicate="R = pending ∖ {j}" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g3" org.eventb.core.label="grd4" org.eventb.core.predicate="pending = R ∪ {j}" org.eventb.core.theorem="true" />
    <org.eventb.core.guard name="g4" org.eventb.core.label="grd5" org.eventb.core.predicate="j ∉ R" org.eventb.core.theorem="true" />
    <org.eventb.core.guard name="g5" org.eventb.core.label="grd6" org.eventb.core.predicate="finite(R)" org.eventb.core.theorem="true" />
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="pending ≔ R" />
    <org.eventb.core.action name="a1" org.eventb.core.label="act2" org.eventb.core.assignment="committed ≔ committed ∪ {j}" />
  </org.eventb.core.event>
  <org.eventb.core.event name="e4" org.eventb.core.label="CancelConfirmed" org.eventb.core.convergence="0" org.eventb.core.extended="false">
    <org.eventb.core.parameter name="p0" org.eventb.core.identifier="j" />
    <org.eventb.core.parameter name="p1" org.eventb.core.identifier="R" />
    <org.eventb.core.guard name="g0" org.eventb.core.label="grd1" org.eventb.core.predicate="j ∈ pending" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g1" org.eventb.core.label="grd2" org.eventb.core.predicate="R = pending ∖ {j}" org.eventb.core.theorem="false" />
    <org.eventb.core.guard name="g2" org.eventb.core.label="grd3" org.eventb.core.predicate="pending = R ∪ {j}" org.eventb.core.theorem="true" />
    <org.eventb.core.guard name="g3" org.eventb.core.label="grd4" org.eventb.core.predicate="j ∉ R" org.eventb.core.theorem="true" />
    <org.eventb.core.guard name="g4" org.eventb.core.label="grd5" org.eventb.core.predicate="finite(R)" org.eventb.core.theorem="true" />
    <org.eventb.core.action name="a0" org.eventb.core.label="act1" org.eventb.core.assignment="pending ≔ R" />
    <org.eventb.core.action name="a1" org.eventb.core.label="act2" org.eventb.core.assignment="cancelled ≔ cancelled ∪ {j}" />
    <org.eventb.core.action name="a2" org.eventb.core.label="act3" org.eventb.core.assignment="used ≔ used − 1" />
  </org.eventb.core.event>
</org.eventb.core.machineFile>